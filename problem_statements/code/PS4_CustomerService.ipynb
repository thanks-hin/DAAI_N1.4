import pandas as pd

orders = pd.read_csv("ORDER.csv")
order_items = pd.read_csv("ORDER_ITEMS.csv")

order_items["item_revenue"] = (
    order_items["quantity"] * order_items["unit_price"]
) - order_items["discount_amount"]

order_summary = (
    order_items.groupby("order_id")["item_revenue"].sum().reset_index()
)

df = pd.merge(orders, order_summary, on="order_id", how="left")

ps4_df = (
    df.groupby("sales_employee_id")
    .agg(
        tong_so_hoa_don=("order_id", "count"),
        so_hoa_don_thanh_cong=(
            "order_status",
            lambda x: (x == "delivered").sum(),
        ),
        tong_doanh_so=("item_revenue", "sum"),
        doanh_thu_tb_hoa_don=("item_revenue", "mean"),
    )
    .reset_index()
)

ps4_df["ty_le_chuyen_doi"] = (
    ps4_df["so_hoa_don_thanh_cong"] / ps4_df["tong_so_hoa_don"]
) * 100

ps4_df["rank_ty_le_chuyen_doi"] = (
    ps4_df["ty_le_chuyen_doi"]
    .rank(ascending=False, method="min")
    .astype(int)
)

ps4_df["rank_doanh_thu_tb"] = (
    ps4_df["doanh_thu_tb_hoa_don"]
    .rank(ascending=False, method="min")
    .astype(int)
)

ps4_df["rank_tong_doanh_so"] = (
    ps4_df["tong_doanh_so"]
    .rank(ascending=False, method="min")
    .astype(int)
)

ps4_df["rank_tong_hop"] = (
    (
        ps4_df["rank_ty_le_chuyen_doi"]
        + ps4_df["rank_doanh_thu_tb"]
        + ps4_df["rank_tong_doanh_so"]
    )
    / 3
).rank(ascending=True, method="min").astype(int)

ps4_df = ps4_df.sort_values(by="rank_tong_hop").reset_index(drop=True)

print(ps4_df.to_csv(index=False))